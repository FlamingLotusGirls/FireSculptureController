[Unit]
Description=Fire Sculpture Controller
After=network.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
WorkingDirectory=/home/pi/FireSculptureController
Environment=PYTHONPATH=/home/pi/.local/lib/firesculpture
ExecStart=/usr/bin/python3 -u /home/pi/FireSculptureController/flaskServer.py --host 0.0.0.0 --port 80 --sculpture serpent --log-level INFO
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
